{
  // Worker + static assets: the Worker (worker/index.ts) handles /api/* and falls
  // through to the built SPA (./dist) via the ASSETS binding for everything else.
  // Backend foundation for Pro sync — see worker/README.md + docs/pro-sync-design.md.
  // Deployed by Cloudflare Workers Builds via `npx wrangler deploy`.
  // Must match the Cloudflare Worker name (the connected project is "24houringp").
  "name": "24houringp",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist",
    // Lets the Worker serve non-API requests via env.ASSETS.fetch(request).
    "binding": "ASSETS",
    // Clean URLs for the static legal pages: /about → about.html, etc.
    // (auto-trailing-slash is the default; set explicitly so it's guaranteed.)
    "html_handling": "auto-trailing-slash",
    // This is a single-page app: serve index.html for paths with no asset match.
    "not_found_handling": "single-page-application",
    // CRITICAL: without this, the SPA fallback above intercepts *browser document
    // navigations* to /api/* (Accept: text/html) and serves index.html before the
    // Worker runs — which silently broke the OAuth login redirect (curl worked, the
    // browser didn't). Run the Worker first for /api/* so it owns those routes;
    // everything else stays asset-first with the SPA fallback.
    // /health/* and /stories/* also run Worker-first so the 40 retired article
    // URLs can answer with a real 301 (see worker/legacy-redirects.ts); every
    // other path under them falls straight through to ASSETS.
    "run_worker_first": ["/api/*", "/health/*", "/stories/*"]
  },

  // The Worker's D1 database binding (env.DB). Schema: worker/migrations/.
  "d1_databases": [
    { "binding": "DB", "database_name": "24houring", "database_id": "a21e309c-9753-4fe1-91b0-9456ce4c3ec2", "migrations_dir": "worker/migrations" }
  ],

  // Non-secret Polar (billing) config. PRODUCTION (real payments). The access token
  // + webhook secret are SECRETS set in the Worker's runtime "Variables and Secrets"
  // — they MUST be the PRODUCTION values (production OAT with products:read +
  // checkouts:write + customer_sessions:write + subscriptions:write, and the
  // production webhook secret). Set POLAR_SERVER back to "sandbox" to test.
  "vars": {
    "POLAR_SERVER": "production",
    "POLAR_PRODUCT_ID": "7c6f2b4a-718c-47b0-9dd5-bc1aef50dab5",
    // Emails always entitled to Pro (no subscription) + shown the coupon-issuing panel.
    "ADMIN_EMAILS": "singlena@gmail.com",
    // Web Push (Pro closed-tab alarms). Private key = VAPID_PRIVATE_KEY secret.
    "VAPID_PUBLIC_KEY": "BFUzJmVp8uJlFAKIZEEAFr3O1u-FLD7cbvHVXOuHtPNQ5zdZl0j_vgnDvwDNRWo8kmr0uWRv8E5EcHzmdwBy1ls",
    "VAPID_SUBJECT": "mailto:singlena@gmail.com"
  },
  // Minute cron: match each push plan's local HH:MM and send due notifications.
  "triggers": { "crons": ["* * * * *"] }
}
